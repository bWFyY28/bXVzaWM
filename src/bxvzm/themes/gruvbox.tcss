Screen {
    background: #282828;
    color: #d4be98;
}

#title, Footer {
    background: #32302f;
    color: #d4be98;
}

#title {
    height: 1;
    padding: 0 1;
    text-style: bold;
}

DataTable {
    height: 1fr;
    background: #282828;
}

DataTable > .datatable--header {
    background: #32302f;
    color: #d4be98;
}

DataTable > .datatable--cursor {
    background: #7daea3;
    color: #282828;
}

#filter {
    height: 3;
    border: solid #504945;
    margin-bottom: 1;
}

#filter:focus {
    border: solid #7daea3;
}

#library-status {
    height: auto;
    color: #a89984;
}

#views {
    height: 1fr;
    margin: 0 1;
}

TabPane {
    border: solid #504945;
    padding: 1 2;
}

Tabs:focus-within {
    border-bottom: solid #7daea3;
}

Tab.-active {
    color: #7daea3;
    text-style: bold;
}

Underline > .underline--bar {
    color: #7daea3;
}

.empty-state {
    height: auto;
    margin-bottom: 1;
}

#library-root {
    color: #a89984;
    height: 1;
    overflow-x: auto;
}

#player {
    height: 3;
    margin: 0 1;
    padding: 0 1;
    border: solid #7daea3;
    background: #32302f;
}

HelpScreen {
    align: center middle;
    background: #282828 85%;
}

#help-dialog {
    width: 52;
    height: auto;
    padding: 1 2;
    border: solid #7daea3;
    background: #32302f;
}

.transfer-actions {
    height: 3;
}

.transfer-actions Button {
    margin-right: 1;
    background: #32302f;
    color: #d4be98;
    border: solid #504945;
    min-width: 16;
}

.transfer-actions Button:focus {
    border: solid #7daea3;
}

#import-jobs {
    height: 6;
}

#import-detail, #download-status {
    height: auto;
    margin: 1 0;
}
